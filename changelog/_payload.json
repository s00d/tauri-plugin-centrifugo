,149,150],"ul",{},[151,152,153,154,158,159,162,163,166,167,170,171,174,175,174,178,174,181,174,184,187,188,190,191,194,195,197],"li",{},"TLS uses ",[155,156,157],"code",{},"ring"," instead of the SDK's default ",[155,160,161],{},"aws-lc-rs",": ",[155,164,165],{},"centrifuge-client"," is pulled with\n",[155,168,169],{},"default-features = false"," plus ",[155,172,173],{},"json",", ",[155,176,177],{},"serde",[155,179,180],{},"http-stream",[155,182,183],{},"delta",[155,185,186],{},"system-proxy"," and ",[155,189,157],{},". Apps no longer\nget a second TLS engine (and the C\u002Fcmake build of ",[155,192,193],{},"aws-lc-sys",") next to the ",[155,196,157],{}," that Tauri apps already use.",[143,199,201],{"id":200},"fixed","Fixed",[148,203,204,221],{},[151,205,206,207,210,211,214,215,217,218,220],{},"Events could reach the frontend out of order, e.g. a channel's ",[155,208,209],{},"subscribed"," before the client's ",[155,212,213],{},"connected",": client\nand subscription events were read from separate streams by separate tasks. They now go through the SDK handlers,\nwhich run one at a time in the SDK's order. The scenario model checks that ",[155,216,213],{}," comes before ",[155,219,209],{},".",[151,222,223,224,226,227,230],{},"Android: the webpki-roots TLS config names the ",[155,225,157],{}," provider explicitly; ",[155,228,229],{},"rustls::ClientConfig::builder()","\ncould panic at connect when the app enabled both rustls providers.",[134,232,234,237],{"id":233},"_022-2026-11-13",[138,235,236],{},"0.2.2"," - 2026-11-13",[143,239,201],{"id":240},"fixed-1",[148,242,243,257],{},[151,244,245,248,249,252,253,256],{},[155,246,247],{},"connect"," with a channel listed twice (",[155,250,251],{},"channels: [\"a\", \"a\"]",") failed with ",[155,254,255],{},"duplicate subscription"," and left no\nclient; the channel is now subscribed once.",[151,258,259,261],{},[155,260,247],{}," with an invalid config (e.g. a bad header) closed the current connection before failing; it now fails\nand keeps the current connection.",[143,263,146],{"id":264},"changed-1",[148,266,267],{},[151,268,269,272,273,276,277,280],{},[155,270,271],{},"subRefresh"," with track\u002Funtrack fields fails with ",[155,274,275],{},"Not supported"," even when not connected\n(it was ",[155,278,279],{},"NotConnected"," first), like map publish.",[143,282,284],{"id":283},"added","Added",[148,286,287,300],{},[151,288,289,290,295,296,299],{},"Mutation testing with ",[126,291,294],{"href":292,"rel":293},"https:\u002F\u002Fmutants.rs",[130],"cargo-mutants"," (",[155,297,298],{},".cargo\u002Fmutants.toml",", run locally).",[151,301,302,303,306,307,310],{},"Scenario tests (",[155,304,305],{},"tests\u002F",", replacing the per-function tests): proptest command sequences over IPC\nchecked against a model after every step, offline and with two apps against a real Centrifugo (replies, events,\nhistory, presence), plus stories for tokens, server-side subscriptions (",[155,308,309],{},"server_*"," via the server API) and\ntransport failures.",[134,312,314,317],{"id":313},"_021-2026-11-09",[138,315,316],{},"0.2.1"," - 2026-11-09",[143,319,201],{"id":320},"fixed-2",[148,322,323,351],{},[151,324,325,328,329,174,332,335,336,339,340,343,344,187,347,350],{},[155,326,327],{},"centrifugo:default"," now includes ",[155,330,331],{},"allow-provide-token",[155,333,334],{},"allow-add-subscription-with-options"," and\n",[155,337,338],{},"allow-remove-all-subscriptions","; with only the default set, ",[155,341,342],{},"provideToken"," (the token bridge),\n",[155,345,346],{},"addSubscriptionWithOptions",[155,348,349],{},"removeAllSubscriptions"," were denied.",[151,352,353,354,174,357,360,361,364,365,174,368,174,371,374,375,174,378,187,381,384,385,388,389,220],{},"Event listeners (",[155,355,356],{},"onConnected",[155,358,359],{},"onPublication",", ...) get the whole Tauri event again (",[155,362,363],{},"{ event, payload, id }",",\nas typed and as in 0.1.x). 0.2.0 passed only the payload, so ",[155,366,367],{},"onMessage",[155,369,370],{},"onChannelMessage",[155,372,373],{},"onAnyMessage",",\n",[155,376,377],{},"onPublicationRawJson",[155,379,380],{},"onServerPublicationRawJson",[155,382,383],{},"helpers.subscribeToChannel(s)"," threw on every publication.\nCode written for 0.2.0 that reads ",[155,386,387],{},"e.channel"," must read ",[155,390,391],{},"e.payload.channel",[143,393,395],{"id":394},"removed","Removed",[148,397,398],{},[151,399,400,401,187,404,407],{},"Stale ",[155,402,403],{},"allow-\u002Fdeny-start-connection",[155,405,406],{},"allow-\u002Fdeny-stop-connection"," permissions (no such commands).",[143,409,284],{"id":410},"added-1",[148,412,413],{},[151,414,415,416],{},"Documentation site: ",[126,417,418],{"href":418,"rel":419},"https:\u002F\u002Fs00d.github.io\u002Ftauri-plugin-centrifugo\u002F",[130],[134,421,423,426],{"id":422},"_020-2026-11-08",[138,424,425],{},"0.2.0"," - 2026-11-08",[143,428,146],{"id":429},"changed-2",[148,431,432,459,474,490,518],{},[151,433,434,438,439,445,446,174,449,174,452,455,456,220],{},[435,436,437],"strong",{},"Breaking:"," the client is now the official Rust SDK ",[126,440,443],{"href":441,"rel":442},"https:\u002F\u002Fgithub.com\u002Fcentrifugal\u002Fcentrifuge-rust",[130],[155,444,165],{},"\ninstead of the internal engine. Its modules (",[155,447,448],{},"client",[155,450,451],{},"config",[155,453,454],{},"protocol",", ...) are no longer re-exported;\nthe SDK is available as ",[155,457,458],{},"tauri_plugin_centrifugo::centrifuge",[151,460,461,462,465,466,469,470,473],{},"The connection token callback (",[155,463,464],{},"need_token",") is installed only when ",[155,467,468],{},"token"," is set or ",[155,471,472],{},"requestToken: true",";\nanonymous connections no longer wait for the frontend.",[151,475,476,479,480,482,483,485,486,489],{},[155,477,478],{},"refresh"," answers a pending ",[155,481,464],{}," (else sets the token for the next connect); ",[155,484,271],{}," answers\n",[155,487,488],{},"need_sub_token",". The SDK refreshes tokens itself before they expire.",[151,491,492,494,495,174,498,174,501,504,505,508,509,512,513,508,515,220],{},[155,493,209],{}," event carries ",[155,496,497],{},"wasRecovering",[155,499,500],{},"recovered",[155,502,503],{},"streamPosition","; ",[155,506,507],{},"connecting","\u002F",[155,510,511],{},"disconnected"," carry ",[155,514,155],{},[155,516,517],{},"reason",[151,519,520],{},"guest-js is built with Vite 8 and TypeScript 6; dual ESM\u002FCJS types; checked with publint and attw.",[143,522,284],{"id":523},"added-2",[148,525,526,538,548,563,574],{},[151,527,528,531,532,174,535,220],{},[155,529,530],{},"StartConfig.httpStreamUrl"," (HTTP-streaming fallback), ",[155,533,534],{},"headers",[155,536,537],{},"requestToken",[151,539,540,543,544,547],{},[155,541,542],{},"SubscribeOptions.delta"," (fossil) and ",[155,545,546],{},"since"," (resume from a saved position).",[151,549,550,174,552,174,555,558,559,562],{},[155,551,488],{},[155,553,554],{},"join",[155,556,557],{},"leave"," events; ",[155,560,561],{},"onNeedSubToken"," helper.",[151,564,565,566,569,570,573],{},"Android: ",[155,567,568],{},"wss:\u002F\u002F"," works out of the box (Mozilla roots via ",[155,571,572],{},"webpki-roots",").",[151,575,576],{},"End-to-end tests against a real Centrifugo, CI on Linux, macOS and Windows, Android build check.",[143,578,580],{"id":579},"deprecated","Deprecated",[148,582,583,589],{},[151,584,585,588],{},[155,586,587],{},"ping"," (resolves when connected; the SDK pings by itself).",[151,590,591,592,508,595,508,598,600,601,220],{},"Map publish fields (",[155,593,594],{},"type",[155,596,597],{},"key",[155,599,394],{},") and track\u002Funtrack sub refresh fields: rejected with ",[155,602,275],{},[143,604,201],{"id":605},"fixed-3",[148,607,608,611],{},[151,609,610],{},"A newer token request no longer makes the previous one fail as unauthorized (which disconnected the client for good).",[151,612,613,614,617],{},"Example app: endless log loop (",[155,615,616],{},"attachConsole"," + console forwarding) that froze the UI on Android; autocorrect on inputs.",[134,619,621],{"id":620},"_01x",[138,622,623],{},"0.1.x",[143,625,284],{"id":626},"added-3",[148,628,629,632,635,638,641,644,647,650,653],{},[151,630,631],{},"Initial release of Tauri Plugin Centrifugo",[151,633,634],{},"Real-time communication with Centrifugo server",[151,636,637],{},"WebSocket support with JSON and Protobuf protocols",[151,639,640],{},"Channel subscription management",[151,642,643],{},"JWT authentication support",[151,645,646],{},"Event-driven architecture for connection state and messages",[151,648,649],{},"Cross-platform support (desktop and mobile)",[151,651,652],{},"TypeScript\u002FJavaScript API bindings",[151,654,655],{},"Example Svelte application",[143,657,146],{"id":658},"changed-3",[148,660,661],{},[151,662,663],{},"N\u002FA",[143,665,580],{"id":666},"deprecated-1",[148,668,669],{},[151,670,663],{},[143,672,395],{"id":673},"removed-1",[148,675,676],{},[151,677,663],{},[143,679,201],{"id":680},"fixed-4",[148,682,683],{},[151,684,663],{},[143,686,688],{"id":687},"security","Security",[148,690,691],{},[151,692,663],{},{"title":694,"searchDepth":695,"depth":696,"links":697},"",2,3,[698,703,709,715,722],{"id":136,"depth":695,"text":699,"children":700},"0.2.3 - 2026-11-18",[701,702],{"id":145,"depth":696,"text":146},{"id":200,"depth":696,"text":201},{"id":233,"depth":695,"text":704,"children":705},"0.2.2 - 2026-11-13",[706,707,708],{"id":240,"depth":696,"text":201},{"id":264,"depth":696,"text":146},{"id":283,"depth":696,"text":284},{"id":313,"depth":695,"text":710,"children":711},"0.2.1 - 2026-11-09",[712,713,714],{"id":320,"depth":696,"text":201},{"id":394,"depth":696,"text":395},{"id":410,"depth":696,"text":284},{"id":422,"depth":695,"text":716,"children":717},"0.2.0 - 2026-11-08",[718,719,720,721],{"id":429,"depth":696,"text":146},{"id":523,"depth":696,"text":284},{"id":579,"depth":696,"text":580},{"id":605,"depth":696,"text":201},{"id":620,"