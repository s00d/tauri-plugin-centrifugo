ng, onConnected, onDisconnected, onError,\n  onSubscribed, onPublication, helpers, utils,\n} from \"tauri-plugin-centrifugo-api\";\n\nconst unlisten = [\n  await onConnecting(({ payload }) => console.log(\"connecting\", payload.code, payload.reason)),\n  await onConnected(({ payload }) => console.log(\"connected, client\", payload.client)),\n  await onDisconnected(({ payload }) => console.log(\"disconnected\", payload.code, payload.reason)),\n  await onError(({ payload }) => console.error(payload.channel ?? \"client\", payload.error)),\n  await onSubscribed(({ payload }) => console.log(\"subscribed to\", payload.channel)),\n  await onPublication(({ payload }) => {\n    \u002F\u002F `rawJson` is set when the data is valid JSON; `data` is always base64.\n    console.log(payload.channel, payload.rawJson ?? utils.decode(payload.data));\n  }),\n];\n\nawait connect({\n  url: \"ws:\u002F\u002Flocalhost:8000\u002Fconnection\u002Fwebsocket\",\n  token: \"\u003Cconnection JWT>\", \u002F\u002F omit for anonymous connections\n  channels: [\"news\"],        \u002F\u002F subscribed with default options\n  useProtobuf: false,\n});\n\n\u002F\u002F connect() returns at once; wait for the `connected` state before calling the server.\nif (await helpers.waitForConnection(5000)) {\n  await addSubscription(\"chat\");\n  await helpers.publishJson(\"news\", { text: \"hello\" });\n}\n\n\u002F\u002F Later:\nawait disconnect();\nunlisten.forEach((fn) => fn());\n","main.ts","ts","",[126,139,140,153,174,197,220,242,249,265,328,371,421,474,518,537,544,598,609,617,622,636,654,674,699,713,722,727,733,762,782,826,832,837,843,855],{"__ignoreMap":137},[141,142,145,149],"span",{"class":143,"line":144},"line",1,[141,146,148],{"class":147},"s7zQu","import",[141,150,152],{"class":151},"sMK4o"," {\n",[141,154,156,160,163,166,168,171],{"class":143,"line":155},2,[141,157,159],{"class":158},"sTEyZ","  connect",[141,161,162],{"class":151},",",[141,164,165],{"class":158}," disconnect",[141,167,162],{"class":15