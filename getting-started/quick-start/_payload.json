948],{"className":925,"code":947,"language":927,"meta":137,"style":137},"cd examples\u002Ftauri-app\npnpm install\npnpm tauri dev\n",[126,949,950,958,966],{"__ignoreMap":137},[141,951,952,955],{"class":143,"line":144},[141,953,954],{"class":273},"cd",[141,956,957],{"class":234}," examples\u002Ftauri-app\n",[141,959,960,963],{"class":143,"line":155},[141,961,962],{"class":934},"pnpm",[141,964,965],{"class":234}," install\n",[141,967,968,970,973],{"class":143,"line":176},[141,969,962],{"class":934},[141,971,972],{"class":234}," tauri",[141,974,975],{"class":234}," dev\n",[122,977,978,979,982],{},"Connect it to ",[126,980,981],{},"ws:\u002F\u002Flocalhost:8001\u002Fconnection\u002Fwebsocket",". The config allows anonymous clients to\nsubscribe, publish and read history, and enables presence, join\u002Fleave and HTTP streaming — for\nlocal testing only.",[916,984,986],{"id":985},"development","Development",[131,988,990],{"className":925,"code":989,"language":927,"meta":137,"style":137},"cargo build && cargo test   # scenario tests, offline and against a real Centrifugo\npnpm build && pnpm test     # guest-js: build + dist checks, unit tests\ncargo mutants               # mutation testing (cargo install cargo-mutants)\n",[126,991,992,1012,1028],{"__ignoreMap":137},[141,993,994,997,1000,1003,1006,1009],{"class":143,"line":144},[141,995,996],{"class":934},"cargo",[141,998,999],{"class":234}," build",[141,1001,1002],{"class":151}," &&",[141,1004,1005],{"class":934}," cargo",[141,1007,1008],{"class":234}," test",[141,1010,1011],{"class":542},"   # scenario tests, offline and against a real Centrifugo\n",[141,1013,1014,1016,1018,1020,1023,1025],{"class":143,"line":155},[141,1015,962],{"class":934},[141,1017,999],{"class":234},[141,1019,1002],{"class":151},[141,1021,1022],{"class":934}," pnpm",[141,1024,1008],{"class":234},[141,1026,1027],{"class":542},"     # guest-js: build + dist checks, unit tests\n",[141,1029,1030,1032,1035],{"class":143,"line":176},[141,1031,996],{"class":934},[141,1033,1034],{"class":234}," mutants",[141,1036,1037],{"class":542},"               # mutation testing (cargo install cargo-mutants)\n",[122,1039,1040,1041,1044,1045,1051],{},"The tests in ",[126,1042,1043],{},"tests\u002F"," drive the plugin over IPC, as the JS API does. They test\nscenarios, not single functions: ",[895,1046,1050],{"href":1047,"rel":1048},"https:\u002F\u002Fproptest-rs.github.io\u002Fproptest\u002F",[1049],"nofollow","proptest"," generates\nrandom command sequences (connect, subscribe, publish, history, presence, tokens, ...) for one\napp without a server and for two apps against a real Centrifugo, and after every step compares\nreplies, events, history and presence with a small model; a failing sequence is shrunk to the\nshortest one. Stories cover what random steps can't reach: token refresh, server-side\nsubscriptions, transport failures and the HTTP-streaming fallback; each story is a short test\nwith a Given\u002FWhen\u002FThen comment:",[1053,1054,1055,1068],"table",{},[1056,1057,1058],"thead",{},[1059,1060,1061,1065],"tr",{},[1062,1063,1064],"th",{},"File",[1062,1066,1067],{},"Scenarios",[1069,1070,1071,1082,1092,1102,1112],"tbody",{},[1059,1072,1073,1079],{},[1074,1075,1076],"td",{},[126,1077,1078],{},"offline_model.rs",[1074,1080,1081],{},"random command sequences, no server",[1059,1083,1084,1089],{},[1074,1085,1086],{},[126,1087,1088],{},"server_model.rs",[1074,1090,1091],{},"random command sequences of two apps against Centrifugo",[1059,1093,1094,1099],{},[1074,1095,1096],{},[126,1097,1098],{},"tokens.rs",[1074,1100,1101],{},"token from the frontend, refresh before expiry",[1059,1103,1104,1109],{},[1074,1105,1106],{},[126,1107,1108],{},"server_side.rs",[1074,1110,1111],{},"join\u002Fleave, personal server-side channel, server disconnect and unsubscribe",[1059,1113,1114,1119],{},[1074,1115,1116],{},[126,1117,1118],{},"transport.rs",[1074,1120,1121,1122,1125],{},"dead server, refused connection, HTTP-streaming fallback, ",[126,1123,1124],{},"send"," with no handler",[122,1127,1128,1131,1132,1134,1135,1138,1139,1142],{},[126,1129,1130],{},"cargo test"," starts the ",[126,1133,935],{}," binary from ",[126,1136,1137],{},"PATH"," (or ",[126,1140,1141],{},"$CENTRIFUGO_BIN",") and skips the\nserver tests when it is missing. CI runs everything on Linux, macOS and Windows against\nCentrifugo v5.4.9 and builds for Android.",[122,1144,1145,1150,1151,1154,1155,1157,1158,1161,1162,1164],{},[895,1146,1149],{"href":1147,"rel":1148},"https:\u002F\u002Fmutants.rs",[1049],"cargo-mutants"," checks that the tests catch changes to the code: it\nmutates ",[126,1152,1153],{},"src\u002F"," and expects ",[126,1156,1130],{}," to fail for each mutant. Config and the few excluded\nmutants (with the reason) are in ",[126,1159,1160],{},".cargo\u002Fmutants.toml","; it needs ",[126,1163,935],{}," as well, or the\nserver tests skip and most mutants survive. It runs locally only, not in CI.",[1166,1167,1168],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sHdIc, html code.shiki .sHdIc{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#EEFFFF;--shiki-default-font-style:italic;--shiki-dark:#BABED8;--shiki-dark-font-style:italic}