Rejects when none is pending.",[140,545,546,551],{},[162,547,548],{},[148,549,550],{},"provideToken(\"\")",[162,552,553,554,557,558,561],{},"\"No token\": an anonymous connect on the first connect; on a refresh the server disconnects the client as unauthorized (",[148,555,556],{},"disconnected",", code ",[148,559,560],{},"1",").",[140,563,564,569],{},[162,565,566],{},[148,567,568],{},"refresh({ token })",[162,570,540,571,573],{},[148,572,177],{},"; when none is pending, sets the token for the next connect.",[140,575,576,581],{},[162,577,578],{},[148,579,580],{},"setToken(token)",[162,582,583],{},"Replaces the token used from the next connect attempt; does not answer a request.",[122,585,586,587,590,591,593],{},"All of them reject with ",[148,588,589],{},"NotConnected"," when there is no client (",[148,592,181],{}," with \"no token\nrequest in progress\").",[126,595,597],{"id":596},"subscription-tokens","Subscription tokens",[122,599,600,601,603],{},"A subscription created with ",[148,602,170],{}," refreshes it the same way, per channel:",[223,605,607],{"className":225,"code":606,"language":227,"meta":228,"style":228},"import { addSubscriptionWithOptions, onNeedSubToken, subRefresh } from \"tauri-plugin-centrifugo-api\";\n\nawait onNeedSubToken(async ({ payload }) => {\n  const token = await fetch(`\u002Fapi\u002Fcentrifugo\u002Fsub-token?channel=${encodeURIComponent(payload.channel)}`)\n    .then((r) => r.text());\n  await subRefresh({ channel: payload.channel, token });\n});\n\nawait addSubscriptionWithOptions({ channel: \"$private:42\", token: firstToken });\n",[148,608,609,640,644,667,708,735,768,776,780],{"__ignoreMap":228},[232,610,611,613,615,618,620,623,625,628,630,632,634,636,638],{"class":234,"line":235},[232,612,239],{"class":238},[232,614,243],{"class":242},[232,616,617],{"class":246}," addSubscriptionWithOptions",[232,619,250],{"class":242},[232,621,622],{"class":246}," onNeedSubToken",[232,624,250],{"class":242},[232,626,627],{"class":246}," subRefresh"