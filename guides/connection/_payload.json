s",[424,607,608,609,611,612,614,615,618,619,621,622,437,625,628],{},"The SDK keeps the connection alive by itself: it reconnects with backoff after a network error,\nwatches server pings and notices a wake from sleep. Each attempt emits ",[134,610,436],{}," (with the\n",[134,613,134],{}," and ",[134,616,617],{},"reason"," of the loss) and then ",[134,620,440],{},". Subscriptions are resubscribed after a\nreconnect (",[134,623,624],{},"subscribing",[134,626,627],{},"subscribed","), and recoverable ones get the missed publications.",[424,630,631,634,635,638,639,641],{},[134,632,633],{},"disconnected"," comes after ",[134,636,637],{},"disconnect()"," or when the server closes the connection with a code\nthat forbids reconnecting (for example an invalid token). From that state the SDK does not\nreconnect; call ",[134,640,428],{}," again.",[122,643,645],{"id":644},"state","State",[127,647,649],{"className":129,"code":648,"language":131,"meta":132,"style":132},"import { isConnected, getConnectionState, helpers } from \"tauri-plugin-centrifugo-api\";\n\nawait isConnected();             \u002F\u002F true only in the connected state\nawait getConnectionState();      \u002F\u002F 'connecting' | 'connected' | 'disconnected' | 'closed'\nawait helpers.waitForConnection(10_000); \u002F\u002F polls isConnected() every 100 ms; false on timeout\n",[134,650,651,682,686,701,714],{"__ignoreMap":132},[137,652,653,655,657,660,662,665,667,670,672,674,676,678,680],{"class":139,"line":140},[137,654,144],{"class":143},[137,656,148],{"class":147},[137,658,659],{"class":151}," isConnected",[137,661,231],{"class":147},[137,663,664],{"class":151}," getConnectionState",[137,666,231],{"class":147},[137,668,669],{"class":151}," helpers",[137,671,155],{"class":147},[137,673,158],{"class":143},[137,675,161],{"class":147},[137,677,165],{"class":164},[137,679,168],{"class":147},[137,681,171],{"class":147},[137,683,684],{"class":139,"line":174},[137,685,178],{"emptyLinePlaceholder":177},[137,687,688,690